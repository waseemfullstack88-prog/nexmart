// This is the Prisma schema for NexMart - Multi-Tenant E-Commerce Platform
// SQLite Version for Development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          String    @default("STORE_OWNER") // SUPER_ADMIN, STORE_OWNER, STAFF
  storeId       String?   @map("store_id")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  store         Store?    @relation("StoreStaff", fields: [storeId], references: [id])
  ownedStores   Store[]   @relation("StoreOwner")

  @@map("users")
}

// ============================================
// STORES & TENANCY
// ============================================

model Store {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  ownerId       String      @map("owner_id")
  templateId    String?     @map("template_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  owner         User        @relation("StoreOwner", fields: [ownerId], references: [id])
  template      Template?   @relation(fields: [templateId], references: [id])
  staff         User[]      @relation("StoreStaff")
  domains       StoreDomain[]
  settings      StoreSettings?
  appearance    StoreAppearance?
  products      Product[]
  categories    Category[]
  media         Media[]
  orders        Order[]
  customers     Customer[]
  pages         Page[]
  menus         Menu[]
  discounts     Discount[]
  coupons       Coupon[]
  homepageSections HomepageSection[]

  @@map("stores")
}

model StoreDomain {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  domain      String   @unique
  isPrimary   Boolean  @default(false) @map("is_primary")
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_domains")
}

model StoreSettings {
  id              String   @id @default(uuid())
  storeId         String   @unique @map("store_id")
  storeName       String?  @map("store_name")
  description     String?  
  email           String?
  phone           String?
  address         String?  // JSON string
  currency        String   @default("USD")
  currencySymbol  String   @default("$") @map("currency_symbol")
  language        String   @default("en")
  timezone        String   @default("UTC")
  logoUrl         String?  @map("logo_url")
  faviconUrl      String?  @map("favicon_url")
  socialLinks     String?  // JSON string
  copyrightText   String?  @map("copyright_text")
  headerConfig    String?  // JSON string
  footerConfig    String?  // JSON string
  seoDefaults     String?  // JSON string
  imageSettings   String?  // JSON string
  businessInfo    String?  // JSON string
  updatedAt       DateTime @updatedAt @map("updated_at")

  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model StoreAppearance {
  id                String   @id @default(uuid())
  storeId           String   @unique @map("store_id")
  primaryColor      String   @default("#6366f1") @map("primary_color")
  secondaryColor    String   @default("#8b5cf6") @map("secondary_color")
  accentColor       String   @default("#f59e0b") @map("accent_color")
  bgColor           String   @default("#ffffff") @map("bg_color")
  textColor         String   @default("#1f2937") @map("text_color")
  buttonColor       String   @default("#6366f1") @map("button_color")
  buttonTextColor   String   @default("#ffffff") @map("button_text_color")
  fontFamily        String   @default("Inter") @map("font_family")
  borderRadius      String   @default("8px") @map("border_radius")
  headerStyle       String   @default("default") @map("header_style")
  footerStyle       String   @default("default") @map("footer_style")
  productCardStyle  String   @default("default") @map("product_card_style")
  imageFit          String   @default("COVER") @map("image_fit") // CONTAIN, COVER, AUTO
  customCss         String?  // JSON string
  updatedAt         DateTime @updatedAt @map("updated_at")

  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_appearances")
}

// ============================================
// TEMPLATES
// ============================================

model Template {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?  
  thumbnailUrl    String?  @map("thumbnail_url")
  category        String?
  defaultConfig   String?  // JSON string
  sectionsConfig  String?  // JSON string
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  stores          Store[]

  @@map("templates")
}

// ============================================
// HOMEPAGE SECTIONS
// ============================================

model HomepageSection {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  sectionType String   @map("section_type")
  title       String?
  subtitle    String?
  config      String?  // JSON string
  sortOrder   Int      @default(0) @map("sort_order")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("homepage_sections")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  name              String
  slug              String
  description       String?   
  shortDescription  String?   @map("short_description") 
  specifications    String?   // JSON string
  price             Float     
  compareAtPrice    Float?    @map("compare_at_price") 
  costPrice         Float?    @map("cost_price") 
  sku               String?
  barcode           String?
  isPublished       Boolean   @default(false) @map("is_published")
  isFeatured        Boolean   @default(false) @map("is_featured")
  trackInventory    Boolean   @default(true) @map("track_inventory")
  stockQuantity     Int       @default(0) @map("stock_quantity")
  lowStockThreshold Int       @default(5) @map("low_stock_threshold")
  categoryId        String?   @map("category_id")
  tags              String?   // JSON string
  seo               String?   // JSON string
  imageFit          String    @default("AUTO") @map("image_fit") // CONTAIN, COVER, AUTO
  weight            Float?    
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  variants          ProductVariant[]
  orderItems        OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, isPublished])
  @@index([storeId, isFeatured])
  @@index([storeId, categoryId])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  mediaId     String   @map("media_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  media       Media    @relation(fields: [mediaId], references: [id])

  @@map("product_images")
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  name          String
  attributes    String    // JSON string
  sku           String?
  price         Float?    
  stockQuantity Int       @default(0) @map("stock_quantity")
  isAvailable   Boolean   @default(true) @map("is_available")
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductVariantImage[]
  orderItems    OrderItem[]

  @@map("product_variants")
}

model ProductVariantImage {
  id          String         @id @default(uuid())
  variantId   String         @map("variant_id")
  mediaId     String         @map("media_id")
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media       Media          @relation(fields: [mediaId], references: [id])

  @@map("product_variant_images")
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id            String     @id @default(uuid())
  storeId       String     @map("store_id")
  name          String
  slug          String
  description   String?    
  parentId      String?    @map("parent_id")
  imageMediaId  String?    @map("image_media_id")
  sortOrder     Int        @default(0) @map("sort_order")
  isEnabled     Boolean    @default(true) @map("is_enabled")
  seo           String?    // JSON string
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryHierarchy")
  image         Media?     @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  products      Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, parentId])
  @@map("categories")
}

// ============================================
// MEDIA
// ============================================

model Media {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  originalName  String    @map("original_name")
  filename      String
  path          String
  mimeType      String    @map("mime_type")
  fileSize      Int       @map("file_size")
  width         Int?
  height        Int?
  altText       String?   @map("alt_text")
  variants      String?   // JSON string
  createdAt     DateTime  @default(now()) @map("created_at")

  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productImages ProductImage[]
  variantImages ProductVariantImage[]
  categoryImages Category[]

  @@index([storeId])
  @@map("media")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id              String        @id @default(uuid())
  storeId         String        @map("store_id")
  customerId      String?       @map("customer_id")
  orderNumber     String        @map("order_number")
  status          String        @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  subtotal        Float         
  discountAmount  Float         @default(0) @map("discount_amount") 
  shippingAmount  Float         @default(0) @map("shipping_amount") 
  taxAmount       Float         @default(0) @map("tax_amount") 
  total           Float         
  shippingAddress String?       // JSON string @map("shipping_address")
  billingAddress  String?       // JSON string @map("billing_address")
  paymentMethod   String?       @map("payment_method")
  paymentStatus   String        @default("PENDING") @map("payment_status") // PENDING, PAID, FAILED, REFUNDED
  shippingMethod  String?       @map("shipping_method")
  notes           String?       
  couponId        String?       @map("coupon_id")
  customerEmail   String?       @map("customer_email")
  customerName    String?       @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, customerId])
  @@map("orders")
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String          @map("order_id")
  productId     String?         @map("product_id")
  variantId     String?         @map("variant_id")
  productName   String          @map("product_name")
  variantName   String?         @map("variant_name")
  sku           String?
  unitPrice     Float           @map("unit_price") 
  quantity      Int
  total         Float           
  imageUrl      String?         @map("image_url")
  createdAt     DateTime        @default(now()) @map("created_at")

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id            String    @id @default(uuid())
  storeId       String    @map("store_id")
  email         String
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses     CustomerAddress[]
  orders        Order[]

  @@unique([storeId, email])
  @@index([storeId])
  @@map("customers")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  label         String?
  addressLine1  String   @map("address_line_1")
  addressLine2  String?  @map("address_line_2")
  city          String
  state         String?
  country       String
  postalCode    String?  @map("postal_code")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

// ============================================
// PAGES & MENUS
// ============================================

model Page {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  title       String
  slug        String
  content     String?  
  isPublished Boolean  @default(false) @map("is_published")
  seo         String?  // JSON string
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@map("pages")
}

model Menu {
  id          String       @id @default(uuid())
  storeId     String       @map("store_id")
  location    String       @default("HEADER") // HEADER, FOOTER
  label       String
  url         String
  sortOrder   Int          @default(0) @map("sort_order")
  parentId    String?      @map("parent_id")
  isEnabled   Boolean      @default(true) @map("is_enabled")
  createdAt   DateTime     @default(now()) @map("created_at")

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent      Menu?        @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Menu[]       @relation("MenuHierarchy")

  @@index([storeId, location])
  @@map("menus")
}

// ============================================
// DISCOUNTS & COUPONS
// ============================================

model Discount {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  name        String
  type        String        // PERCENTAGE, FIXED
  value       Float         
  scope       String        // PRODUCT, CATEGORY, ORDER
  targetId    String?       @map("target_id")
  startsAt    DateTime?     @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("discounts")
}

model Coupon {
  id              String       @id @default(uuid())
  storeId         String       @map("store_id")
  code            String
  type            String       // PERCENTAGE, FIXED
  value           Float        
  minOrderAmount  Float?       @map("min_order_amount") 
  usageLimit      Int?         @map("usage_limit")
  timesUsed       Int          @default(0) @map("times_used")
  startsAt        DateTime?    @map("starts_at")
  endsAt          DateTime?    @map("ends_at")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")

  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@unique([storeId, code])
  @@index([storeId])
  @@map("coupons")
}
