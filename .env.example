# ============================================
# NexMart - Multi-Tenant E-Commerce Platform
# Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://nexmart:nexmart_pass@localhost:5432/nexmart?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
API_PORT=4000
API_HOST="http://localhost:4000"
NODE_ENV="development"

# Frontend URLs
ADMIN_URL="http://localhost:3001"
STOREFRONT_URL="http://localhost:3000"
PLATFORM_ADMIN_URL="http://localhost:3002"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_KB=4096
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048
IMAGE_QUALITY=80
IMAGE_OUTPUT_FORMAT="webp"

# Super Admin (created on first seed)
SUPER_ADMIN_EMAIL="admin@nexmart.com"
SUPER_ADMIN_PASSWORD="NexMart@Admin123"

# Optional: S3-Compatible Storage (for future use)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION=""

# Optional: SMTP (for future use)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
